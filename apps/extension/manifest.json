{
  "manifest_version": 3,
  "name": "SevaDesk Companion",
  "version": "2.0.0",
  "description": "Operator companion for assisted entry on verified government portals. Fills only reviewed fields; never submits.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
